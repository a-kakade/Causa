# Raw Olist dataset — download separately per README, do not commit
data/raw/olist/*.csv
data/raw/olist/_profile_summary.json
archive.zip

# Processed canonical layer (Step 2) — regenerate via scripts/step2_04_build_canonical.py,
# do not commit (large, fully reproducible from raw data + scripts)
data/processed/*.parquet

# Evidence fabric (Step 4) rebuildable artifacts — neither is a source of
# truth (fact_reviews.parquet is); regenerate via scripts/step4_validate_engine.py
data/evidence/embedding_cache/*.npz
data/evidence/vector_index/*.npy
data/evidence/vector_index/*.jsonl

